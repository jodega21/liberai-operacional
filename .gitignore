# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code
.claude/

# Supabase CLI temp files
supabase/.temp/
# Notas locais do Claude Code (não versionar)
memory/

# Arquivos de diagnóstico locais (OFX de amostra, scripts de debug)
debug/

docs/_scratch/

# Seed de clientes do legado NFe — dados pessoais (LGPD) + output volumoso; só os scripts geradores são versionados
scripts/import-clientes/origem/
scripts/import-clientes/saida/

# Exploração: diretório INTEIRO fora do versionamento — dados reais
# (LGPD) + artefatos de sonda (padrão D40). Script que merecer
# versionamento sai daqui.
scripts/exploration/

*.sql
!supabase/migrations/*.sql
!supabase/validacao/*.sql
# Carga em partes (o SQL Editor do Studio recusa o arquivo inteiro) e stubs do teste no PGlite: sem dado pessoal.
!supabase/migrations/*/*.sql
!supabase/testes/*.sql
# Dumps de diff gerados para revisao (scratchpad, nao versionar)
*.diff
.vscode/