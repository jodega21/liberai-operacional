NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Envio de e-mail pelo Amazon SES (LEI5 fatia 2): usuario IAM so com permissao de envio (ses:SendEmail).
# Nomes SES_* porque a Vercel reserva parte das variaveis AWS_*.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_REGION=us-east-2
# Endereco publico do app, para as imagens do e-mail (marca). Padrao: https://liberai-operacional.vercel.app
URL_PUBLICA_OPERACIONAL=
